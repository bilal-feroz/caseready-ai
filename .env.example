# Auth (required in production — Vercel throws a Configuration error without it)
AUTH_SECRET=secretsecretsecretsecretsecretsecret
NEXTAUTH_SECRET=secretsecretsecretsecretsecretsecret
NEXTAUTH_URL=http://localhost:3000

# Demo controls
DEMO_MODE=true

# Database
# Local dev / tests use a local SQLite file (no config needed).
DATABASE_PATH=./data/caseready.db
# Production on Vercel: point at a hosted Turso (libSQL) database.
# Create one at https://turso.tech, then set both of these in Vercel env vars:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token

# Optional AI drafting (leave blank to run in template mode)
GEMINI_API_KEY=
